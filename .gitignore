# Ігноруємо віртуальне середовище (воно дуже важке і в кожного розробника своє)
venv/
env/

# Ігноруємо бази даних (щоб не залити випадково реальні паролі чи дані користувачів)
db.sqlite3
*.sqlite3
*.db3

# Ігноруємо кеш, який генерує сам Python під час роботи
__pycache__/
*.pyc
*.pyo

# Ігноруємо папку з локальними налаштуваннями вашого PyCharm
.idea/

# Ігноруємо файли з секретними ключами (на майбутнє)
.env